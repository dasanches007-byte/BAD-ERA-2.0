# BAD ERA environment contract. Copy to .env.local and fill in.
# Never commit .env.local. Never put a secret behind a NEXT_PUBLIC_ prefix.

# --- Supabase -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Publishable (anon) key. NOTE: `anon` intentionally holds no public-table
# grants — the storefront renders from trusted server code. This key exists for
# Supabase Auth flows only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# SERVER ONLY. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe -------------------------------------------------------------
# SERVER ONLY.
STRIPE_SECRET_KEY=""

# SERVER ONLY. Verifies the raw webhook body signature.
# Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Resend (Phase 7) ---------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- Site Editor preview (Phase 4) --------------------------------------
# Minimum 16 characters. Generate with: openssl rand -hex 32
PREVIEW_SECRET=""
