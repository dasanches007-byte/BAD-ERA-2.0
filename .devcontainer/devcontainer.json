{
  "name": "BAD ERA",

  // Base image plus the Node feature, rather than a pinned node image tag.
  // The feature installs the requested version on top of a stable base, so a
  // retired image tag cannot break the Codespace months from now.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },

  // The dev server.
  //
  // `openBrowser`, NOT `openPreview`. The preview panel embeds the site in an
  // iframe served from a different origin than the forwarded port, and the
  // Phase 9 security headers set `frame-ancestors 'self'` — so the panel would
  // render blank. A real tab is also the better experience on a phone.
  //
  // (The Site Editor's own draft preview is unaffected: that iframe is
  // same-origin, which `'self'` permits.)
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "BAD ERA — storefront and Studio",
      "onAutoForward": "openBrowser"
    }
  },

  // Not a secret: the project URL is public by nature and never changes. Set
  // here so it is one fewer thing to paste on a phone.
  "containerEnv": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://snkvgpfpnphvbkiafptd.supabase.co"
  },

  // Recommended secrets. GitHub lists these on the "Create codespace" page
  // (codespaces.new/dasanches007-byte/BAD-ERA-2.0) with a box for each, so the
  // owner pastes them once while creating the Codespace. GitHub stores them
  // encrypted as the owner's Codespaces secrets — they are never committed,
  // which matters because this repository is public.
  //
  // Keys are deliberately NOT hard-coded in containerEnv even where they are
  // public-by-design (the anon key): rotating the project's JWT secret
  // replaces the anon key too, and a stale committed value would break the
  // Codespace with an auth error that looks unrelated.
  "secrets": {
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": {
      "description": "Supabase anon / publishable key. Supabase dashboard -> Project Settings -> API.",
      "documentationUrl": "https://supabase.com/dashboard/project/snkvgpfpnphvbkiafptd/settings/api"
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "description": "Supabase service_role key (secret, server-only). Same page, under 'service_role'.",
      "documentationUrl": "https://supabase.com/dashboard/project/snkvgpfpnphvbkiafptd/settings/api"
    }
  },

  // Runs once, when the Codespace is first created.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Runs every time you open the Codespace, including after it sleeps.
  "postAttachCommand": "bash .devcontainer/start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "vscode"
}
